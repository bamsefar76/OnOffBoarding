@page
@model UserChangeQueueWeb.Pages.TemporaryAccess.IndexModel
@using UserChangeQueueWeb.Services
@inject UiTextService UiTextService
@{
    var fallbacks = new Dictionary<string, string>
    {
        ["ta.title"] = "Temporary access",
        ["ta.intro"] = "Request temporary access to an approved resource.",
        ["ta.current"] = "Current access",
        ["ta.requestAccess"] = "Request temporary access",
        ["ta.resource"] = "Resource",
        ["ta.choose"] = "Choose a resource",
        ["ta.duration"] = "Duration",
        ["ta.days"] = "days",
        ["ta.reason"] = "Reason",
        ["ta.reasonRequired"] = "A reason is required for this resource.",
        ["ta.request"] = "Request access",
        ["ta.renew"] = "Renew",
        ["ta.remove"] = "Remove",
        ["ta.expires"] = "Active until",
        ["ta.pendingAdd"] = "Waiting to be added",
        ["ta.processingAdd"] = "Adding",
        ["ta.active"] = "Active",
        ["ta.pendingRemove"] = "Waiting to be removed",
        ["ta.processingRemove"] = "Removing",
        ["ta.noneCurrent"] = "You do not currently have temporary access.",
        ["ta.noneAvailable"] = "No additional temporary access resources are available.",
        ["common.status"] = "Status",
        ["common.actions"] = "Actions"
    };

    var text = await UiTextService.GetTextsAsync(HttpContext, fallbacks);
    ViewData["Title"] = text.T("ta.title", fallbacks["ta.title"]);

    string T(string key) => text.T(key, fallbacks[key]);

    var currentGroups = Model.Groups.Where(g => g.MembershipId.HasValue).ToList();
    var availableGroups = Model.Groups.Where(g => !g.MembershipId.HasValue).ToList();
}

<div class="mb-4">
    <h1 class="h2 mb-1">@T("ta.title")</h1>
    <p class="text-body-secondary mb-0">@T("ta.intro")</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<section class="mb-5">
    <h2 class="h4 mb-3">@T("ta.current")</h2>

    @if (currentGroups.Count == 0)
    {
        <div class="alert alert-secondary mb-0">@T("ta.noneCurrent")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>@T("ta.resource")</th>
                        <th>@T("common.status")</th>
                        <th>@T("ta.expires")</th>
                        <th class="text-end">@T("common.actions")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var group in currentGroups)
                {
                    var statusText = group.Status switch
                    {
                        "PendingAdd" => T("ta.pendingAdd"),
                        "ProcessingAdd" => T("ta.processingAdd"),
                        "Active" => T("ta.active"),
                        "PendingRemove" => T("ta.pendingRemove"),
                        "ProcessingRemove" => T("ta.processingRemove"),
                        _ => group.Status ?? ""
                    };

                    <tr>
                        <td>
                            <div class="fw-semibold">@group.DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(group.Description))
                            {
                                <div class="small text-body-secondary">@group.Description</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(group.LastError))
                            {
                                <div class="small text-danger mt-1">@group.LastError</div>
                            }
                        </td>
                        <td>@statusText</td>
                        <td>
                            @if (group.ExpiresAt.HasValue)
                            {
                                @group.ExpiresAt.Value.ToString("dd.MM.yyyy HH:mm")
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                @if (group.Status == "Active" && group.AllowRenewal)
                                {
                                    <form method="post" asp-page-handler="Renew">
                                        <input type="hidden" name="id" value="@group.MembershipId" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">
                                            @T("ta.renew")
                                        </button>
                                    </form>
                                }
                                @if (group.Status is "PendingAdd" or "Active")
                                {
                                    <form method="post" asp-page-handler="Remove">
                                        <input type="hidden" name="id" value="@group.MembershipId" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            @T("ta.remove")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section>
    <h2 class="h4 mb-3">@T("ta.requestAccess")</h2>

    @if (availableGroups.Count == 0)
    {
        <div class="alert alert-secondary">@T("ta.noneAvailable")</div>
    }
    else
    {
        <form method="post" asp-page-handler="Request" class="card">
            <div class="card-body p-3 p-md-4">
                <div class="mb-3">
                    <label asp-for="GroupId" class="form-label">@T("ta.resource")</label>
                    <select asp-for="GroupId"
                            class="form-select"
                            id="temporaryAccessGroup"
                            required>
                        <option value="">@T("ta.choose")</option>
                        @foreach (var group in availableGroups)
                        {
                            <option value="@group.Id"
                                    data-description="@group.Description"
                                    data-duration="@group.DurationDays"
                                    data-require-reason="@group.RequireReason.ToString().ToLowerInvariant()">
                                @group.DisplayName
                            </option>
                        }
                    </select>
                    <div id="temporaryAccessDescription" class="form-text"></div>
                    <div id="temporaryAccessDuration" class="form-text"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Reason" class="form-label">@T("ta.reason")</label>
                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="3"
                              id="temporaryAccessReason"></textarea>
                    <div id="temporaryAccessReasonRequired"
                         class="form-text text-danger d-none">
                        @T("ta.reasonRequired")
                    </div>
                </div>

                <button class="btn btn-primary" type="submit">@T("ta.request")</button>
            </div>
        </form>
    }
</section>

@section Scripts {
<script>
(() => {
    const select = document.getElementById("temporaryAccessGroup");
    if (!select) return;

    const description = document.getElementById("temporaryAccessDescription");
    const duration = document.getElementById("temporaryAccessDuration");
    const reason = document.getElementById("temporaryAccessReason");
    const reasonRequired = document.getElementById("temporaryAccessReasonRequired");

    function updateSelection() {
        const option = select.options[select.selectedIndex];
        const hasSelection = Boolean(option && option.value);

        description.textContent = hasSelection
            ? (option.dataset.description || "")
            : "";

        duration.textContent = hasSelection
            ? `@T("ta.duration"): ${option.dataset.duration} @T("ta.days")`
            : "";

        const requiresReason =
            hasSelection && option.dataset.requireReason === "true";

        reason.required = requiresReason;
        reasonRequired.classList.toggle("d-none", !requiresReason);
    }

    select.addEventListener("change", updateSelection);
    updateSelection();
})();
</script>
}
