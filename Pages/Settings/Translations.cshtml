@page
@model UserChangeQueueWeb.Pages.SettingsAdmin.TranslationsModel
@{
    ViewData["Title"] = Model.T("translations.title", "Translations");
}

<h1>@Model.T("translations.title", "Translations")</h1>
<p class="text-muted">@Model.T("translations.description", "Maintain UI text for all enabled languages.")</p>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="Search">@Model.T("translations.search", "Search")</label>
                <input class="form-control" id="Search" name="Search" value="@Model.Search" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Category">@Model.T("translations.category", "Category")</label>
                <select class="form-select" id="Category" name="Category">
                    <option value="">All</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category" selected="@(string.Equals(Model.Category, category, StringComparison.OrdinalIgnoreCase))">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Language">@Model.T("translations.language", "Language")</label>
                <select class="form-select" id="Language" name="Language">
                    <option value="">All</option>
                    @foreach (var language in Model.Languages)
                    {
                        <option value="@language.LanguageCode" selected="@(string.Equals(Model.Language, language.LanguageCode, StringComparison.OrdinalIgnoreCase))">@language.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 form-check mt-4 pt-3">
                <input class="form-check-input" type="checkbox" id="OnlyMissingForLanguage" name="OnlyMissingForLanguage" value="true" checked="@Model.OnlyMissingForLanguage" />
                <label class="form-check-label" for="OnlyMissingForLanguage">@Model.T("translations.onlyMissing", "Only missing")</label>
            </div>
            <div class="col-md-1 form-check mt-4 pt-3">
                <input class="form-check-input" type="checkbox" id="ShowInactive" name="ShowInactive" value="true" checked="@Model.ShowInactive" />
                <label class="form-check-label" for="ShowInactive">@Model.T("translations.showInactive", "Show inactive")</label>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">@Model.T("translations.applyFilters", "Apply filters")</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@Model.T("translations.addKey", "Add text key")</div>
            <div class="card-body">
                <form method="post" asp-page-handler="CreateKey" class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">@Model.T("translations.key", "Key")</label>
                        <input class="form-control" asp-for="NewKey" placeholder="usercreate.privateEmail" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Model.T("translations.category", "Category")</label>
                        <input class="form-control" asp-for="NewCategory" placeholder="UserCreate" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">English text</label>
                        <input class="form-control" asp-for="NewEnglishText" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-primary" type="submit">@Model.T("translations.addKey", "Add text key")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@Model.T("translations.addLanguage", "Add language")</div>
            <div class="card-body">
                <form method="post" asp-page-handler="AddLanguage" class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" asp-for="NewLanguageCode" placeholder="de" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Display name</label>
                        <input class="form-control" asp-for="NewLanguageDisplayName" placeholder="German" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Native name</label>
                        <input class="form-control" asp-for="NewLanguageNativeName" placeholder="Deutsch" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Sort</label>
                        <input class="form-control" asp-for="NewLanguageSortOrder" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-primary" type="submit">@Model.T("translations.addLanguage", "Add language")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<form method="post" asp-page-handler="SaveVisible">
    <input type="hidden" name="Search" value="@Model.Search" />
    <input type="hidden" name="Category" value="@Model.Category" />
    <input type="hidden" name="ShowInactive" value="@Model.ShowInactive" />
    <input type="hidden" name="Language" value="@Model.Language" />
    <input type="hidden" name="OnlyMissingForLanguage" value="@Model.OnlyMissingForLanguage" />
    <input type="hidden" name="RowCount" value="@Model.Rows.Count" />

    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 260px;">@Model.T("translations.key", "Key")</th>
                    <th style="min-width: 160px;">@Model.T("translations.category", "Category")</th>
                    <th class="text-center">@Model.T("translations.active", "Active")</th>
                    @foreach (var language in Model.DisplayLanguages)
                    {
                        <th style="min-width: 260px;">@language.NativeName (@language.LanguageCode)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="@(3 + Model.DisplayLanguages.Count)" class="text-muted">@Model.T("translations.noRows", "No translation rows matched the filter.")</td>
                    </tr>
                }
                else
                {
                    for (var i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        <tr>
                            <td>
                                <code>@row.UiTextKey</code>
                                <input type="hidden" name="RowKey_@i" value="@row.UiTextKey" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" name="Category_@i" value="@row.Category" />
                            </td>
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" name="Active_@i" value="true" checked="@row.Active" />
                            </td>
                            @foreach (var language in Model.DisplayLanguages)
                            {
                                var value = row.Values.TryGetValue(language.LanguageCode, out var text) ? text : "";
                                <td>
                                    <textarea class="form-control form-control-sm" rows="2" name="Value_@i@("_")@language.LanguageCode">@value</textarea>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Rows.Count > 0)
    {
        <button class="btn btn-primary" type="submit">@Model.T("translations.saveVisible", "Save visible texts")</button>
    }
</form>
