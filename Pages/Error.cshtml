@page
@model ErrorModel
@using UserChangeQueueWeb.Services
@inject UiTextService UiTextService

@{
    var textFallbacks = new Dictionary<string, string>
    {
        ["error.title"] = "Error",
        ["error.heading"] = "Error.",
        ["error.message"] = "An error occurred while processing your request.",
        ["error.requestId"] = "Request ID",
        ["error.developmentMode"] = "Development mode",
        ["error.developmentInfo"] = "Switching to the Development environment displays detailed information about the error.",
        ["error.developmentWarning"] = "The Development environment should not be enabled for deployed applications because it can display sensitive information to end users."
    };

    var uiText = await UiTextService.GetTextsAsync(HttpContext, textFallbacks);
    string T(string key) => uiText.T(key, textFallbacks[key]);

    ViewData["Title"] = T("error.title");
}

<h1 class="text-danger">@T("error.heading")</h1>
<h2 class="text-danger">@T("error.message")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T("error.requestId"):</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@T("error.developmentMode")</h3>
<p>@T("error.developmentInfo")</p>
<p><strong>@T("error.developmentWarning")</strong></p>
