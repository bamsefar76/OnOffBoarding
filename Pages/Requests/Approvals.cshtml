@page
@model ApprovalsModel
@using UserChangeQueueWeb.Services
@inject UiTextService UiTextService
@{
    var textFallbacks = new Dictionary<string, string>
    {
        ["common.all"] = "All",
        ["common.yes"] = "Yes",
        ["common.no"] = "No",
        ["common.now"] = "Now",
        ["common.filter"] = "Filter",
        ["common.clear"] = "Clear",
        ["common.title"] = "Title",
        ["common.department"] = "Project / department",
        ["common.company"] = "Company",
        ["common.office"] = "Office",
        ["common.computer"] = "Computer",
        ["common.select"] = "Select",
        ["common.status"] = "Status",
        ["common.actions"] = "Actions",
        ["field.employeeType"] = "Employee type",
        ["field.officeLicense"] = "Office license",
        ["field.accessCardRequired"] = "Access card",
        ["field.executeAfter"] = "Start date",
        ["approvals.title"] = "Pending approvals",
        ["approvals.help"] = "Review and approve pending user requests.",
        ["approvals.requestType"] = "Request type",
        ["approvals.requestedByContains"] = "Requested by contains",
        ["approvals.noPending"] = "No pending requests need approval.",
        ["approvals.approveSelected"] = "Approve selected",
        ["approvals.rejectSelected"] = "Reject selected",
        ["approvals.confirmRejectSelected"] = "Reject the selected request(s)? They will not be processed by the queue worker.",
        ["approvals.confirmRejectOne"] = "Reject request {0}? It will not be processed by the queue worker.",
        ["approvals.request"] = "Request",
        ["approvals.user"] = "User",
        ["approvals.details"] = "Details",
        ["approvals.requestedBy"] = "Requested by",
        ["approvals.created"] = "Created",
        ["approvals.waitUntilTime"] = "Approved requests wait until this time.",
        ["approvals.actions"] = "Approval actions",
        ["approvals.approve"] = "Approve",
        ["approvals.reject"] = "Reject",
        ["approvals.openRequest"] = "Open request",
        ["approvals.futureRequest"] = "Future request",
        ["approvals.requestNumber"] = "Request #{0}"
    };

    var uiText = await UiTextService.GetTextsAsync(HttpContext, textFallbacks);
    ViewData["Title"] = uiText.T("approvals.title", textFallbacks["approvals.title"]);

    string T(string key) => uiText.T(key, textFallbacks[key]);
    string F(string key, params object[] args) =>
        string.Format(uiText.T(key, textFallbacks[key]), args);

    var rejectSelectedConfirm = T("approvals.confirmRejectSelected");
    var approvalActionsText = T("approvals.actions");
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@T("approvals.title")</h1>
        <p class="text-body-secondary mb-0">@T("approvals.help")</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
}

<form method="get" class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label asp-for="RequestType" class="form-label">@T("approvals.requestType")</label>
                <select asp-for="RequestType" class="form-select">
                    <option value="">@T("common.all")</option>
                    <option value="CREATE">CREATE</option>
                    <option value="UPDATE">UPDATE</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-4">
                <label asp-for="RequestedBy" class="form-label">@T("approvals.requestedByContains")</label>
                <input asp-for="RequestedBy" class="form-control" />
            </div>
            <div class="col-lg-auto d-flex gap-2">
                <button type="submit" class="btn btn-secondary">@T("common.filter")</button>
                <a asp-page="/Requests/Approvals" class="btn btn-outline-secondary">@T("common.clear")</a>
            </div>
        </div>
    </div>
</form>

@if (Model.PendingRequests.Count == 0)
{
    <div class="alert alert-success" role="alert">@T("approvals.noPending")</div>
}
else
{
    <form method="post">
        <input type="hidden" asp-for="RequestType" />
        <input type="hidden" asp-for="RequestedBy" />

        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="submit" class="btn btn-primary" asp-page-handler="ApproveSelected">
                @T("approvals.approveSelected")
            </button>
            <button type="submit"
                    class="btn btn-outline-danger"
                    asp-page-handler="RejectSelected"
                    onclick="return confirm('@rejectSelectedConfirm');">
                @T("approvals.rejectSelected")
            </button>
        </div>

        <div class="vstack gap-3">
            @foreach (var request in Model.PendingRequests)
            {
                var rejectOneConfirm = F("approvals.confirmRejectOne", request.RequestId);
                var requestType = request.DisplayRequestType;
                var secondaryAddress = !string.IsNullOrWhiteSpace(request.NewUserPrincipalName)
                    ? request.NewUserPrincipalName
                    : request.Mail;

                <article class="card approval-card @(request.IsDue ? "" : "approval-card-future")">
                    <div class="card-body p-3 p-lg-4">
                        <div class="d-flex flex-column flex-xl-row gap-3 justify-content-between">
                            <div class="d-flex align-items-start gap-3 min-w-0">
                                <input class="form-check-input mt-1 flex-shrink-0"
                                       type="checkbox"
                                       name="SelectedRequestIds"
                                       value="@request.RequestId"
                                       aria-label="@T("common.select")" />

                                <div class="min-w-0">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <a class="h5 mb-0 text-decoration-none text-break"
                                           href="@request.EditUrl">
                                            @request.DisplayText
                                        </a>
                                        <span class="badge text-bg-secondary">@requestType</span>
                                        @if (!request.IsDue)
                                        {
                                            <span class="badge text-bg-warning">@T("approvals.futureRequest")</span>
                                        }
                                    </div>

                                    <div class="text-body-secondary small d-flex flex-wrap gap-x-3 gap-y-1">
                                        <a href="@request.EditUrl" class="text-decoration-none">
                                            @F("approvals.requestNumber", request.RequestId)
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(secondaryAddress))
                                        {
                                            <span class="text-break">@secondaryAddress</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 align-self-start flex-shrink-0">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@request.EditUrl">
                                    @T("approvals.openRequest")
                                </a>
                                <button type="submit"
                                        class="btn btn-sm btn-success"
                                        asp-page-handler="Approve"
                                        asp-route-requestId="@request.RequestId">
                                    @T("approvals.approve")
                                </button>
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        asp-page-handler="Reject"
                                        asp-route-requestId="@request.RequestId"
                                        onclick="return confirm('@rejectOneConfirm');">
                                    @T("approvals.reject")
                                </button>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="row g-3 approval-meta">
                            <div class="col-sm-6 col-lg-3">
                                <div class="approval-label">@T("field.executeAfter")</div>
                                <div>@(request.ExecuteAfter?.ToString("dd.MM.yyyy HH:mm") ?? T("common.now"))</div>
                                @if (!request.IsDue)
                                {
                                    <div class="small text-body-secondary mt-1">@T("approvals.waitUntilTime")</div>
                                }
                            </div>

                            <div class="col-sm-6 col-lg-3">
                                <div class="approval-label">@T("approvals.requestedBy")</div>
                                <div class="text-break">@request.RequestedBy</div>
                            </div>

                            <div class="col-sm-6 col-lg-2">
                                <div class="approval-label">@T("approvals.created")</div>
                                <div>@request.CreatedAt?.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>

                            <div class="col-lg-4">
                                <div class="approval-label">@T("approvals.details")</div>
                                <dl class="approval-details mb-0">
                                    @if (!string.IsNullOrWhiteSpace(request.Title))
                                    {
                                        <div><dt>@T("common.title")</dt><dd>@request.Title</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.Department))
                                    {
                                        <div><dt>@T("common.department")</dt><dd>@request.Department</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.Company))
                                    {
                                        <div><dt>@T("common.company")</dt><dd>@request.Company</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.Office))
                                    {
                                        <div><dt>@T("common.office")</dt><dd>@request.Office</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.EmployeeType))
                                    {
                                        <div><dt>@T("field.employeeType")</dt><dd>@request.EmployeeType</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.ComputerType))
                                    {
                                        <div><dt>@T("common.computer")</dt><dd>@request.ComputerType</dd></div>
                                    }
                                    <div>
                                        <dt>@T("field.accessCardRequired")</dt>
                                        <dd>@(request.AccessCard ? T("common.yes") : T("common.no"))</dd>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(request.OfficeLicense))
                                    {
                                        <div><dt>@T("field.officeLicense")</dt><dd>@request.OfficeLicense</dd></div>
                                    }
                                </dl>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary" asp-page-handler="ApproveSelected">
                @T("approvals.approveSelected")
            </button>
            <button type="submit"
                    class="btn btn-outline-danger"
                    asp-page-handler="RejectSelected"
                    onclick="return confirm('@rejectSelectedConfirm');">
                @T("approvals.rejectSelected")
            </button>
        </div>
    </form>
}

<style>
    .approval-card {
        border-inline-start: .35rem solid var(--bs-success);
    }

    .approval-card-future {
        border-inline-start-color: var(--bs-warning);
    }

    .approval-label {
        color: var(--bs-secondary-color);
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .035em;
        margin-bottom: .25rem;
        text-transform: uppercase;
    }

    .approval-details {
        display: grid;
        gap: .35rem;
    }

    .approval-details > div {
        display: grid;
        grid-template-columns: minmax(8rem, .8fr) minmax(0, 1.2fr);
        gap: .5rem;
    }

    .approval-details dt {
        font-weight: 600;
    }

    .approval-details dd {
        margin: 0;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .min-w-0 {
        min-width: 0;
    }

    .gap-x-3 {
        column-gap: 1rem;
    }

    .gap-y-1 {
        row-gap: .25rem;
    }

    @@media (max-width: 575.98px) {
        .approval-details > div {
            display: block;
        }

        .approval-details dd {
            margin-top: .1rem;
        }
    }
</style>
