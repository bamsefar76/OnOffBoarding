@page
@model UserPendingChangesModel
@using UserChangeQueueWeb.Services
@inject UiTextService UiTextService

@{
    var textFallbacks = new Dictionary<string, string>
    {
        ["pending.title"] = "Pending user changes",
        ["pending.backToSupervisor"] = "Back to supervisor",
        ["pending.hasPending"] = "This user already has pending changes:",
        ["pending.noPending"] = "No pending changes found for this user.",
        ["pending.editThisChange"] = "Edit this change",
        ["pending.continueToEditUser"] = "Continue to edit user",
        ["pending.noUserSelected"] = "No user selected.",
        ["pending.invalidUserId"] = "Invalid user id.",
        ["field.requestId"] = "Request ID",
        ["field.user"] = "User",
        ["field.requestType"] = "Request type",
        ["field.status"] = "Status",
        ["field.requestedBy"] = "Requested by",
        ["field.created"] = "Created"
    };

    var uiText = await UiTextService.GetTextsAsync(HttpContext, textFallbacks);
    string T(string key) => uiText.T(key, textFallbacks[key]);

    string LocalizeMessage(string? message)
    {
        if (string.Equals(message, textFallbacks["pending.noUserSelected"], StringComparison.Ordinal))
        {
            return T("pending.noUserSelected");
        }

        if (string.Equals(message, textFallbacks["pending.invalidUserId"], StringComparison.Ordinal))
        {
            return T("pending.invalidUserId");
        }

        return message ?? string.Empty;
    }

    ViewData["Title"] = T("pending.title");
}

<h2>@T("pending.title")</h2>

<p>
    <a asp-page="/Requests/Supervisor">@T("pending.backToSupervisor")</a>
</p>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p><strong>@LocalizeMessage(Model.Message)</strong></p>
}

<h3>@Model.DisplayName</h3>

@if (Model.PendingChanges.Count > 0)
{
    <p><strong>@T("pending.hasPending")</strong></p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@T("field.requestId")</th>
                <th>@T("field.user")</th>
                <th>@T("field.requestType")</th>
                <th>@T("field.status")</th>
                <th>@T("field.requestedBy")</th>
                <th>@T("field.created")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var change in Model.PendingChanges)
        {
            <tr>
                <td>@change.Id</td>
                <td>@change.TargetDisplayName</td>
                <td>@change.RequestType</td>
                <td>@change.Status</td>
                <td>@change.RequestedBy</td>
                <td>@(change.CreatedAt?.ToString("g"))</td>
                <td>
                    <a href="/Requests/UpdateUser?requestId=@change.Id">@T("pending.editThisChange")</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>@T("pending.noPending")</p>
}

<p>
    <a class="btn btn-primary"
       href="/Requests/UpdateUser?user=@Model.UserObjectGuid">
        @T("pending.continueToEditUser")
    </a>
</p>
