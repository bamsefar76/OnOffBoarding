@page
@model UserChangeQueueWeb.Pages.LicenseRequests.IndexModel
@{
    ViewData["Title"] = "License applications";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">License applications</h1>
        <p class="text-body-secondary mb-0">
            Request one or more licenses and follow the approval process.
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div asp-validation-summary="All"
     class="text-danger mb-3"></div>

@if (Model.CurrentUser is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <strong>Requested for:</strong>
            @Model.CurrentUser.DisplayName
            <br />
            <strong>Manager:</strong>
            @Model.CurrentUser.ManagerName
        </div>
    </div>
}

<section id="new-license-request"
         class="scroll-margin-top">
    <h2 class="h4 mb-3">Request licenses</h2>

    <form method="post"
          asp-page-handler="Submit">

        <div class="row g-3 mb-4">
            @foreach (var license in Model.Licenses)
            {
                var id = $"license-{license.Id}";

                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 license-card">
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input license-box"
                                       type="checkbox"
                                       name="SelectedLicenseIds"
                                       value="@license.Id"
                                       id="@id"
                                       data-family="@license.ProductFamily"
                                       checked="@Model.SelectedLicenseIds.Contains(license.Id)" />

                                <label class="form-check-label fw-semibold"
                                       for="@id">
                                    @license.Name
                                </label>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(license.Description))
                            {
                                <div class="small text-body-secondary mt-2">
                                    @license.Description
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(license.ProductFamily))
                            {
                                <div class="small text-body-secondary mt-2">
                                    @license.ProductFamily
                                    @if (license.LicenseLevel.HasValue)
                                    {
                                        <span>
                                            · Level @license.LicenseLevel
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <span asp-validation-for="SelectedLicenseIds"
              class="text-danger"></span>

        <div class="mb-3">
            <label asp-for="BusinessReason"
                   class="form-label">
                Business reason
            </label>

            <textarea asp-for="BusinessReason"
                      class="form-control"
                      rows="5"
                      maxlength="2000"
                      required></textarea>

            <span asp-validation-for="BusinessReason"
                  class="text-danger"></span>
        </div>

        <button class="btn btn-primary"
                type="submit">
            Submit to manager
        </button>
    </form>
</section>

<hr class="my-5" />

<section id="my-license-applications"
         class="scroll-margin-top">

    <h2 class="h4">My license requests</h2>

    @if (Model.MyApplications.Count == 0)
    {
        <div class="alert alert-secondary">
            No applications found.
        </div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var application in Model.MyApplications)
            {
                <article class="card">
                    <div class="card-body">

                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <h3 class="h5">
                                Application #@application.Id
                            </h3>

                            <span class="badge text-bg-secondary">
                                @application.Status
                            </span>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">Licenses</dt>
                            <dd class="col-sm-9">
                                @string.Join(
                                    ", ",
                                    application.Items.Select(x => x.Name))
                            </dd>

                            <dt class="col-sm-3">Submitted</dt>
                            <dd class="col-sm-9">
                                @application.SubmittedAt.ToString(
                                    "dd.MM.yyyy HH:mm")
                            </dd>

                            <dt class="col-sm-3">Business reason</dt>
                            <dd class="col-sm-9">
                                @application.BusinessReason
                            </dd>

                            @if (!string.IsNullOrWhiteSpace(
                                    application.ManagerDecision))
                            {
                                <dt class="col-sm-3">
                                    Manager decision
                                </dt>
                                <dd class="col-sm-9">
                                    @application.ManagerDecision
                                </dd>

                                <dt class="col-sm-3">
                                    Manager reason
                                </dt>
                                <dd class="col-sm-9">
                                    @application.ManagerReason
                                </dd>
                            }
                        </dl>
                    </div>
                </article>
            }
        </div>
    }
</section>

<style>
    .scroll-margin-top {
        scroll-margin-top: 5rem;
    }
</style>

@section Scripts {
<script>
(() => {
    const boxes =
        [...document.querySelectorAll(".license-box")];

    function refresh() {
        const selectedFamilies =
            new Set(
                boxes
                    .filter(
                        x => x.checked
                             && x.dataset.family)
                    .map(
                        x => x.dataset.family)
            );

        for (const box of boxes) {
            const disabled =
                box.dataset.family
                && selectedFamilies.has(
                    box.dataset.family)
                && !box.checked;

            box.disabled = disabled;

            box.closest(".license-card")
                ?.classList.toggle(
                    "opacity-50",
                    disabled);
        }
    }

    boxes.forEach(
        x => x.addEventListener(
            "change",
            refresh));

    refresh();
})();
</script>
}
