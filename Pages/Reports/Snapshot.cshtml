@page
@model SnapshotModel
@using UserChangeQueueWeb.Services
@inject UiTextService UiTextService

@{
    var textFallbacks = new Dictionary<string, string>
    {
        ["common.yes"] = "Yes",
        ["common.no"] = "No",
        ["common.total"] = "Total",
        ["common.show"] = "Show",
        ["field.company"] = "Company",
        ["field.count"] = "Count",
        ["field.name"] = "Name",
        ["field.department"] = "Department",
        ["field.title"] = "Title",
        ["field.enabled"] = "Enabled",
        ["field.employeeType"] = "Employee type",
        ["field.office"] = "Office",
        ["field.accountExpirationDate"] = "Account expiration date",
        ["snapshot.title"] = "Monthly AD snapshot",
        ["snapshot.newUserRequest"] = "New user request",
        ["snapshot.supervisor"] = "Supervisor",
        ["snapshot.signOut"] = "Sign out",
        ["snapshot.snapshotMonth"] = "Snapshot month",
        ["snapshot.latestSnapshot"] = "Latest snapshot",
        ["snapshot.allEmployeeTypes"] = "All employee types",
        ["snapshot.noRows"] = "No snapshot rows found.",
        ["snapshot.noSnapshots"] = "No snapshots found in dbo.ADObjectsMonthlySnapshot.",
        ["snapshot.showing"] = "Showing",
        ["snapshot.rowsForSnapshotMonth"] = "rows for snapshot month",
        ["snapshot.employeesByCompany"] = "Employees by company",
        ["snapshot.snapshotMonthColumn"] = "Snapshot month",
        ["snapshot.whenCreated"] = "When created",
        ["snapshot.whenChanged"] = "When changed"
    };

    var uiText = await UiTextService.GetTextsAsync(HttpContext, textFallbacks);
    string T(string key) => uiText.T(key, textFallbacks[key]);
    string LocalizeMessage(string? message)
    {
        if (string.Equals(message, textFallbacks["snapshot.noSnapshots"], StringComparison.Ordinal))
        {
            return T("snapshot.noSnapshots");
        }

        return message ?? string.Empty;
    }

    ViewData["Title"] = T("snapshot.title");
}

<div style="margin-top:10px; margin-bottom:20px;">
    <a href="/Requests/NewUser">@T("snapshot.newUserRequest")</a>
    |
    <a href="/Requests/Supervisor">@T("snapshot.supervisor")</a>
    |
    <a href="/logout" style="color:red; font-weight:bold;">@T("snapshot.signOut")</a>
</div>

<h2>@T("snapshot.title")</h2>

<form method="get" style="margin-bottom:20px;">
    <label>@T("snapshot.snapshotMonth")</label><br />
    <select asp-for="SelectedSnapshotMonth"
            asp-items="Model.SnapshotMonths"
            onchange="this.form.submit()">
        <option value="">@T("snapshot.latestSnapshot")</option>
    </select>

    <br /><br />

    <label>@T("field.employeeType")</label><br />
    <select asp-for="SelectedEmployeeType"
            asp-items="Model.EmployeeTypes"
            onchange="this.form.submit()">
        <option value="">@T("snapshot.allEmployeeTypes")</option>
    </select>

    <br /><br />

    <button type="submit">@T("common.show")</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p><strong>@LocalizeMessage(Model.Message)</strong></p>
}

@if (Model.Rows.Count == 0)
{
    <p>@T("snapshot.noRows")</p>
}
else
{
    <p>
        @T("snapshot.showing") <strong>@Model.Rows.Count</strong> @T("snapshot.rowsForSnapshotMonth") <strong>@Model.EffectiveSnapshotMonth</strong>.
    </p>

    @if (Model.CompanySummary.Any())
    {
        <h3>@T("snapshot.employeesByCompany")</h3>

        <table class="table table-sm table-bordered" style="max-width:600px;">
            <thead>
                <tr>
                    <th>@T("field.company")</th>
                    <th>@T("field.count")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var company in Model.CompanySummary)
            {
                <tr>
                    <td>@company.Company</td>
                    <td>@company.Count</td>
                </tr>
            }
            </tbody>

            <tfoot>
                <tr style="font-weight:bold;">
                    <td>@T("common.total")</td>
                    <td>@Model.CompanySummary.Sum(x => x.Count)</td>
                </tr>
            </tfoot>
        </table>
    }

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@T("snapshot.snapshotMonthColumn")</th>
                <th>@T("field.name")</th>
                <th>@T("field.department")</th>
                <th>@T("field.title")</th>
                <th>@T("field.enabled")</th>
                <th>@T("snapshot.whenCreated")</th>
                <th>@T("snapshot.whenChanged")</th>
                <th>@T("field.company")</th>
                <th>@T("field.employeeType")</th>
                <th>@T("field.accountExpirationDate")</th>
                <th>@T("field.office")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.SnapshotMonth</td>
                    <td>@row.Name</td>
                    <td>@row.Department</td>
                    <td>@row.Title</td>
                    <td>@(row.Enabled.HasValue ? (row.Enabled.Value ? T("common.yes") : T("common.no")) : string.Empty)</td>
                    <td>@(row.WhenCreated?.ToString("d"))</td>
                    <td>@(row.WhenChanged?.ToString("d"))</td>
                    <td>@row.Company</td>
                    <td>@row.EmployeeType</td>
                    <td>@(row.AccountExpirationDate?.ToString("d"))</td>
                    <td>@row.Office</td>
                </tr>
            }
        </tbody>
    </table>
}
