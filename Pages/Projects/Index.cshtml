@page
@model ProjectsModel
@using UserChangeQueueWeb.Services
@inject UiTextService UiTextService

@{
    var textFallbacks = new Dictionary<string, string>
    {
        ["common.yes"] = "Yes",
        ["common.no"] = "No",
        ["common.filter"] = "Filter",
        ["common.edit"] = "Edit",
        ["field.company"] = "Company",
        ["field.enabled"] = "Enabled",
        ["projects.title"] = "Projects",
        ["projects.addNew"] = "Add new project",
        ["projects.showDisabled"] = "Show disabled projects",
        ["projects.projectNumber"] = "Project number",
        ["projects.projectName"] = "Project name",
        ["projects.projectManagers"] = "Project leaders",
        ["projects.producer"] = "Producer",
        ["projects.executive"] = "Executive",
        ["projects.lastUpdated"] = "Last updated"
    };

    var uiText = await UiTextService.GetTextsAsync(HttpContext, textFallbacks);
    string T(string key) => uiText.T(key, textFallbacks[key]);

    ViewData["Title"] = T("projects.title");
}

<h2>@T("projects.title")</h2>

@if (Model.CanEditProjects)
{
    <div style="margin-bottom:20px;">
        <a asp-page="/Projects/Edit">@T("projects.addNew")</a>
    </div>
}

<form method="get" style="margin-bottom:20px;">
    <label>
        <input asp-for="ShowDisabled" type="checkbox" />
        @T("projects.showDisabled")
    </label>

    <button type="submit">@T("common.filter")</button>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@T("projects.projectNumber")</th>
            <th>@T("projects.projectName")</th>
            <th>@T("field.company")</th>
            <th>@T("projects.projectManagers")</th>
            <th>@T("projects.producer")</th>
            <th>@T("projects.executive")</th>
            <th>@T("field.enabled")</th>
            <th>@T("projects.lastUpdated")</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
    @foreach (var project in Model.Projects)
    {
        <tr>
            <td>@project.ProjectNumber</td>
            <td>@project.ProjectName</td>
            <td>@project.Company</td>
            <td>@project.ProjectManagers</td>
            <td>@project.Producer</td>
            <td>@project.Executive</td>
            <td>@(project.Active ? T("common.yes") : T("common.no"))</td>
            <td>@(project.LastUpdated?.ToString("dd.MM.yyyy HH:mm"))</td>
            <td>
                @if (Model.CanEditProjects)
                {
                    <a asp-page="/Projects/Edit" asp-route-id="@project.Id">@T("common.edit")</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
